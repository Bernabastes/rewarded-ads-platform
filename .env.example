# =============================================================================
# Rewarded Ads Platform - environment variables
# Copy to `.env` (repo root; used by docker compose AND the API when run locally).
# Every variable below is read by apps/api/src/config/env.ts (or docker-compose.yml where noted).
# Values shown are the defaults. Secrets must never be committed - only this example file is tracked.
# =============================================================================

# ---------- Runtime ----------
NODE_ENV=development                       # development | test | production (production enforces real secrets)
PORT=3000                                  # API listen port
TRUST_PROXY_HOPS=0                         # Trusted reverse-proxy hops in front of the API (0 = exposed directly, X-Forwarded-For ignored; 1 behind one LB/nginx)
API_PUBLIC_URL=http://localhost:3000       # Public base URL of the API (used in checkout/callback URLs)
ADVERTISER_WEB_URL=http://localhost:5173   # Advertiser portal URL (payment return URL default)
ADMIN_WEB_URL=http://localhost:5174        # Admin dashboard URL (links in alerts)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081   # Comma-separated allowed origins ("*" allows all)
LOG_LEVEL=info                             # trace | debug | info | warn | error | fatal
LOG_PRETTY=true                            # Pretty-print application logs (dev only; use false for JSON)
# SECURITY_LOG_PATH=./logs/security.log    # Optional file destination for the security/fraud log channel (default: stdout, channel=security)
APP_VERSION=0.1.0                          # Reported by /health and GET /admin/config

# ---------- Data stores ----------
DATABASE_URL=postgresql://rap:rap@localhost:5432/rap?schema=public   # PostgreSQL connection string (Prisma). Keep the port in sync with POSTGRES_PORT
REDIS_URL=redis://localhost:6379           # Redis for rate limits, velocity counters, token denylist and BullMQ
QUEUE_PREFIX=rap                           # Key prefix for Redis keys and BullMQ queues
QUEUES_ENABLED=true                        # Start BullMQ workers in this process (false for API-only instances)

# docker compose only (service credentials/ports)
POSTGRES_USER=rap                          # compose: postgres superuser (also used by scripts/backup.*)
POSTGRES_PASSWORD=rap                      # compose: postgres password
POSTGRES_DB=rap                            # compose: database name
POSTGRES_PORT=5432                         # compose: host port of postgres (change if 5432 is taken; keep DATABASE_URL in sync)
REDIS_PORT=6379                            # compose: host port of redis
API_PORT=3000                              # compose: host port of the API container
ADVERTISER_WEB_PORT=5173                   # compose: host port of the nginx-served advertiser portal
ADMIN_WEB_PORT=5174                        # compose: host port of the nginx-served admin dashboard
RUN_SEED=false                             # compose api service: seed demo data on start (RESETS all data)
MINIO_PORT=9000                            # compose: host port of the MinIO S3 API
MINIO_CONSOLE_PORT=9001                    # compose: host port of the MinIO web console

# ---------- Auth ----------
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789   # >= 32 random chars in production (the schema refuses the dev-only value and anything shorter)
JWT_ACCESS_TTL_SECONDS=900                 # Access token lifetime (15 min). The Redis token denylist uses the same TTL
JWT_REFRESH_TTL_DAYS=30                    # Refresh token lifetime (rotating, single use)
IMPERSONATION_TTL_SECONDS=600              # Lifetime of read-only support impersonation tokens (POST /admin/users/:id/impersonate)

# ---------- OTP / SMS ----------
OTP_TTL_SECONDS=300                        # OTP validity
OTP_LENGTH=6                               # Digits per OTP
OTP_MAX_ATTEMPTS=5                         # Wrong attempts before the code is burned
OTP_RESEND_AFTER_SECONDS=60                # Minimum gap between OTPs for one phone
OTP_RATE_LIMIT_PER_PHONE_PER_HOUR=5        # OTP requests per phone per hour (429 OTP_RATE_LIMITED above)
OTP_RATE_LIMIT_PER_IP_PER_HOUR=30          # OTP requests per IP per hour
OTP_VERIFY_LIMIT_PER_PHONE=10              # OTP VERIFY attempts per phone within OTP_VERIFY_WINDOW_SECONDS (brute-force guard on login + destination OTP; 429 OTP_TOO_MANY_ATTEMPTS)
OTP_VERIFY_LIMIT_PER_IP=30                 # OTP VERIFY attempts per client IP within the window
OTP_VERIFY_WINDOW_SECONDS=900              # Verify-throttle window (15 min)
OTP_DEV_ECHO=true                          # Return the OTP in the API response (dev/demo ONLY; rejected in production)
OTP_DEV_FIXED_CODE=123456                  # Accept this code for any phone (dev/demo ONLY; rejected in production). Remove to disable.
SMS_PROVIDER=mock                          # mock (dev only: logs the code in development, redacted elsewhere; REJECTED in production) | http (generic JSON gateway below)
# SMS_API_URL=https://sms.example.et/send  # SMS_PROVIDER=http: gateway endpoint; the API POSTs JSON { to, message, from? } with Authorization: Bearer SMS_API_KEY
# SMS_API_KEY=                             # SMS_PROVIDER=http: bearer key for the gateway
# SMS_SENDER_ID=GIZE                       # SMS_PROVIDER=http: optional sender id / short code
SMS_TIMEOUT_MS=8000                        # SMS_PROVIDER=http: request timeout

# ---------- Platform economics (spec defaults) ----------
COINS_PER_ETB=100                          # 1 ETB = 100 coins
MIN_WITHDRAWAL_ETB=50                      # Minimum withdrawal request
LARGE_WITHDRAWAL_THRESHOLD_ETB=500         # >= this requires two distinct admin approvals
DAILY_AD_COMPLETION_LIMIT=15               # Max rewarded ad completions per user per UTC day
PLATFORM_TAKE_RATE=0.50                    # Platform share of advertiser spend (user reward = cost * (1 - rate))
MIN_WATCH_RATIO=0.9                        # Fraction of the ad duration that must elapse on the server clock
MAX_WATCH_RATIO=3                          # Completion after duration*ratio + grace is rejected as implausible
WATCH_GRACE_SECONDS=60                     # Grace added to the maximum plausible watch time
MIN_AGE=18                                 # Minimum age (server-side DOB check; Gregorian or Ethiopian DOB accepted)
HEARTBEAT_INTERVAL_SECONDS=10              # Client heartbeat cadence during playback
MIN_HEARTBEAT_RATIO=0.6                    # Fraction of expected heartbeats that must be received
WATCH_SESSION_TTL_MINUTES=30               # Watch session expiry
DAILY_WITHDRAWAL_REQUEST_LIMIT=3           # Withdrawal requests per user per UTC day
MAX_WATCH_ATTEMPTS_PER_AD_PER_DAY=3        # Retry budget per ad per user per day
MIN_CAMPAIGN_BUDGET_ETB=100                # Minimum campaign budget an advertiser can submit
MIN_COST_PER_ACTION_ETB=0.5                # Minimum cost per valid action an advertiser can set
MIN_TOPUP_ETB=100                          # Minimum wallet top-up
INVOICE_VAT_RATE=0                         # e.g. 0.15 for 15% VAT shown on invoices (amount treated as VAT-inclusive)

# ---------- Frequency capping ----------
DEFAULT_FREQUENCY_CAP=1                    # Default per-campaign rewarded completions per user per UTC day (advertiser-editable 1-5)
ADVERTISER_IMPRESSION_CAP_PER_USER_PER_DAY=3   # Distinct ads from one advertiser a user may complete per UTC day

# ---------- Fraud engine ----------
FRAUD_FLAG_THRESHOLD=40                    # Score >= this => completion flagged (not credited, needs review)
FRAUD_REJECT_THRESHOLD=80                  # Score >= this => completion rejected
FRAUD_MIN_TRUST_FOR_FEED=20                # Users below this trust score get an empty feed
FRAUD_DEVICE_SHARED_ACCOUNTS_THRESHOLD=3   # Distinct accounts per device fingerprint (30 days) before flagging
FRAUD_IP_COMPLETIONS_PER_HOUR_THRESHOLD=30 # Completions per IP per hour before flagging
FRAUD_MIN_ACCOUNT_AGE_HOURS_FOR_FULL_TRUST=24   # Accounts younger than this are scored as "new account"

# ---------- Referrals ----------
REFERRAL_BONUS_COINS=500                   # Coins credited to the referrer with the referee's FIRST valid completion
REFEREE_BONUS_COINS=200                    # Coins credited to the referee at the same moment (same ledger transaction)
REFERRAL_MAX_PER_REFERRER_PER_DAY=5        # Paid referrals per referrer per UTC day (beyond => status qualified, no bonus)
REFERRAL_SHARE_URL=https://gize.app/r/{code}   # Share-link template returned by GET /users/me/referrals ({code} replaced)

# ---------- KYC ----------
KYC_REQUIRED_ABOVE_MONTHLY_ETB=1000        # phone_only users: rolling 30-day payouts + new request AT OR ABOVE this (>=) => 422 KYC_REQUIRED (inclusive boundary; name kept for compatibility)
KYC_DOCUMENT_URL_TTL_SECONDS=300           # Presigned GET links for KYC documents shown to admins (5 min)
ID_VERIFICATION_PROVIDER=mock              # mock (deterministic MockFaydaProvider) | fayda (requires the two credentials below)
FAYDA_BASE_URL=https://api.fayda.et        # Fayda (Ethiopian digital ID) API base URL - confirm with NIDP onboarding docs
# FAYDA_CLIENT_ID=                         # Fayda API client id (real mode only)
# FAYDA_CLIENT_SECRET=                     # Fayda API client secret (real mode only)

# ---------- Withdrawal destination verification ----------
DESTINATION_RESOLVE_TTL_MINUTES=10         # A destination name lookup (and its OTP re-check) is valid this long for a NEW destination

# ---------- Money-day alerting ----------
# ALERT_TELEGRAM_BOT_TOKEN=                # Telegram Bot API token; with ALERT_TELEGRAM_CHAT_ID enables the TelegramNotifier
# ALERT_TELEGRAM_CHAT_ID=                  # Chat/channel id that receives alerts
# ALERT_WEBHOOK_URL=                       # Slack-compatible incoming webhook (JSON { text, blocks }). Unset + no Telegram => alerts only logged
ALERT_RULES_ENABLED=true                   # Run the alert rule job on the schedule below
ALERT_RULES_CRON=*/5 * * * *               # Alert rules evaluation schedule (BullMQ repeatable job)
ALERT_DEDUPE_MINUTES=60                    # The same alert (dedupe key) is not raised again within this window
ALERT_PAYOUT_FAILURE_RATE=0.2              # Payout failure share over the last hour that raises PAYOUT_FAILURE_RATE
ALERT_PAYOUT_MIN_SAMPLE=5                  # Minimum finished payouts in the hour before the failure-rate rule applies
ALERT_ACCOUNTS_PER_DEVICE_PER_HOUR=3       # New accounts sharing one signup device fingerprint per hour => ACCOUNT_MINTING
ALERT_SPEND_VELOCITY_MULTIPLIER=5          # Campaign spend in the last hour > multiplier x trailing 7-day hourly average => SPEND_VELOCITY
ALERT_SPEND_VELOCITY_MIN_ETB=50            # ... only when the last-hour spend is at least this (ETB)
ALERT_OTP_REQUESTS_PER_IP_PER_HOUR=20      # OTP requests from one IP per hour that raise OTP_SPIKE (below the hard rate limit)

# ---------- Media processing (ffprobe / ffmpeg) ----------
MEDIA_PROCESSING_ENABLED=true              # Enqueue media.process for new video creatives (probe + 720p transcode + poster)
# MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg        # Explicit ffmpeg binary (the Docker image installs apk ffmpeg); default: ffmpeg-static, then PATH
# MEDIA_FFPROBE_PATH=/usr/bin/ffprobe      # Explicit ffprobe binary; default: ffprobe-static, then PATH
MEDIA_JOB_TIMEOUT_SECONDS=300              # Hard time-box per media job (download + probe + transcode)
MEDIA_TARGET_HEIGHT=720                    # Transcode target height (H.264 MP4, width keeps aspect ratio)
MEDIA_DURATION_TOLERANCE_SECONDS=1         # |declared - probed| above this corrects duration_seconds (media_status duration_corrected)

# ---------- Data-subject rights ----------
ACCOUNT_DELETION_GRACE_DAYS=14             # Deletion requests execute after this many days unless cancelled
DATA_RIGHTS_CRON=30 * * * *                # Hourly job: execute due deletion requests, expire old data exports
DATA_EXPORT_URL_TTL_SECONDS=900            # Presigned download link lifetime for data exports
DATA_EXPORT_RETENTION_DAYS=7               # Export archives are deleted from storage after this
IDEMPOTENCY_TTL_HOURS=24                   # Idempotency-Key responses are replayable for this long

# ---------- Object storage (S3 compatible; MinIO locally) ----------
S3_ENDPOINT=http://localhost:9000          # S3 API endpoint used by the API (inside compose: http://minio:9000)
S3_PUBLIC_ENDPOINT=http://localhost:9000   # Browser-reachable S3 endpoint embedded in presigned upload URLs (host is part of the signature)
S3_PUBLIC_URL=http://localhost:9000        # Public base URL media is served from
S3_REGION=us-east-1                        # Region string sent in SigV4 (MinIO accepts any)
S3_BUCKET=rap-media                        # Bucket for creatives (public read) and private/ prefixes (KYC docs, data exports)
S3_ACCESS_KEY=minioadmin                   # S3 access key - production REQUIRES a non-default value (env schema)
S3_SECRET_KEY=minioadmin                   # S3 secret key - production REQUIRES a non-default value >= 16 chars (env schema)
S3_FORCE_PATH_STYLE=true                   # Path-style URLs (required for MinIO)
S3_PRESIGN_TTL_SECONDS=900                 # Presigned upload URL lifetime

# ---------- Payments in (Chapa checkout) ----------
# CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxx    # When unset (dev only) the gateway runs in MOCK mode with a local fake checkout page; REQUIRED in production (mock routes are 404 there regardless)
CHAPA_BASE_URL=https://api.chapa.co/v1     # Chapa API base URL (checkout, verify, transfers)
# CHAPA_WEBHOOK_SECRET=xxxxxxxx            # Webhook signing secret from the Chapa dashboard (payload HMAC in Chapa-Signature; REQUIRED in production)

# ---------- Payouts out (telebirr / Chapa transfers) ----------
PAYOUTS_MOCK=true                          # true => both payout providers (and destination name lookup) simulate processing (clearly labelled MOCK). MUST be false in production
PAYOUT_MOCK_FAILURE_RATE=0.1               # Fraction of mock payouts that fail (deterministic per payout id)
PAYOUT_MOCK_PROCESSING_SECONDS=5           # Mock "processing" duration before a final status
PAYOUT_STATUS_POLL_SECONDS=10              # Worker polling interval for provider status
PAYOUT_MAX_ATTEMPTS=3                      # Max payout attempts per withdrawal (admin retries)
TELEBIRR_BASE_URL=https://app.ethiomobilemoney.et:2121   # telebirr open API base URL
# TELEBIRR_APP_ID=                         # telebirr business API credentials (all three required for REAL mode and in production)
# TELEBIRR_APP_KEY=                        # telebirr app key
# TELEBIRR_SHORT_CODE=                     # telebirr merchant short code
# TELEBIRR_PUBLIC_KEY=                     # telebirr RSA public key (payload encryption; confirm with contract docs)

# ---------- Push notifications (FCM HTTP v1) ----------
# FCM_PROJECT_ID=                          # Firebase project id
# FCM_SERVICE_ACCOUNT_JSON=                # Service-account JSON (single line). When unset push is MOCKED (logged)

# ---------- Jobs ----------
RECONCILIATION_ENABLED=true                # Ledger vs cached balance reconciliation job (drift => LEDGER_DRIFT alert)
RECONCILIATION_CRON=0 * * * *              # Hourly

# ---------- Support contact shown in the app ----------
SUPPORT_TELEGRAM_URL=https://t.me/rap_support   # Telegram support link (mobile profile screen)
SUPPORT_PHONE=+251900000000                # Support phone number (mobile profile screen)

# ---------- Phase 5: security remediation ----------
SWAGGER_ENABLED=true                       # Interactive API docs at /api/docs (+ /api/docs-json). Always OFF in production (the schema refuses true)
# KYC_HASH_KEY=                            # HMAC-SHA256 key for the KYC identity-number duplicate hash (#14). REQUIRED (>= 32 chars) in production; dev falls back to JWT_ACCESS_SECRET
# MFA_ENCRYPTION_KEY=                      # Key for admin TOTP secrets at rest (AES-256-GCM). Falls back to a key derived from JWT_ACCESS_SECRET
ADMIN_MFA_REQUIRED=false                   # true => finance/super_admin must enrol TOTP; until then every non-MFA admin route answers 403 MFA_SETUP_REQUIRED
LOGIN_RATE_LIMIT_PER_IP=30                 # Password-login attempts (admin + advertiser) per client IP within LOGIN_WINDOW_SECONDS (429 LOGIN_RATE_LIMITED); higher than per-account so a shared office NAT is not locked out
LOGIN_RATE_LIMIT_PER_ACCOUNT=10            # Password-login attempts per account within the window
LOGIN_WINDOW_SECONDS=900                   # Login throttle window (15 min)
LOGIN_LOCKOUT_THRESHOLD=5                  # Consecutive failures that lock the account (audited + security log)
LOGIN_LOCKOUT_SECONDS=900                  # Lockout duration (423 ACCOUNT_LOCKED)
ALLOW_SEED_IN_PRODUCTION=false             # The seed wipes the DB and creates demo admins; refused with NODE_ENV=production unless explicitly true
DESTINATION_LOOKUPS_PER_DAY=5              # Partner account-name lookups per user per UTC day (#11; 429 DESTINATION_LOOKUP_LIMIT). NEW destinations are only looked up AFTER the destination OTP succeeded (POST .../otp/verify reveals the holder name)
ALERT_DESTINATION_LOOKUPS_PER_IP_PER_HOUR=30   # Alert rule DESTINATION_LOOKUP_SPIKE: lookups per IP per hour
PAYOUT_PROVIDER_TIMEOUT_MS=15000           # HTTP timeout for telebirr/Chapa payout, status and lookup calls (#7)
PAYOUT_MAX_POLLS=500                       # Status polls before a payout is parked as needs_manual_review (never auto-refunded while money may be in flight)
# AUTH_COOKIE_DOMAIN=                      # Cookie-mode refresh tokens (web apps): optional Domain attribute
# AUTH_COOKIE_SECURE=true                  # Cookie-mode refresh tokens: Secure attribute (default: true in production, false otherwise)