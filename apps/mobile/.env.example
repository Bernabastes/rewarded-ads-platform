# Copy to `.env` (git-ignored). Only EXPO_PUBLIC_* variables are exposed to the app bundle.

# Base URL of the API (without /api/v1). On a physical device use your computer's LAN IP,
# e.g. http://192.168.1.20:3000 - "localhost" on the phone points to the phone itself.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: override the support contacts shown in Profile > Support.
EXPO_PUBLIC_SUPPORT_TELEGRAM=https://t.me/rap_support
EXPO_PUBLIC_SUPPORT_PHONE=+251900000000

# Optional: EAS project id used by expo-notifications to mint Expo push tokens.
# Leave empty in local development; push registration then no-ops gracefully.
EXPO_PUBLIC_EAS_PROJECT_ID=
