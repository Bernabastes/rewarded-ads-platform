{
  "expo": {
    "name": "Gize",
    "slug": "gize",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "gize",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F6A4C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "et.gize.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "et.gize.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F6A4C"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.INTERNET", "android.permission.RECEIVE_BOOT_COMPLETED", "android.permission.VIBRATE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      ["expo-video", { "supportsBackgroundPlayback": false, "supportsPictureInPicture": false }],
      ["expo-notifications", { "color": "#1F6A4C" }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gize needs access to your photos to attach your identity document and selfie for verification.",
          "cameraPermission": "Gize uses the camera to photograph your identity document and take a selfie for verification."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1F6A4C",
          "dark": { "backgroundColor": "#121010" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
