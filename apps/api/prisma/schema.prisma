model Survey {
  id               String   @id @default(uuid()) @db.Uuid
  campaignId       String   @map("campaign_id") @db.Uuid
  title            String
  description      String?
  /// { questions: SurveyQuestion[] }
  details          Json
  rewardEtb        Decimal  @map("reward_etb") @db.Decimal(12, 2)
  estimatedMinutes Int      @default(3) @map("estimated_minutes")
  active           Boolean  @default(true)
  maxResponses     Int?     @map("max_responses")
  createdAt        DateTime @default(now()) @map("created_at")

  campaign  Campaign         @relation(fields: [campaignId], references: [id])
  responses SurveyResponse[]

  @@index([campaignId])
  @@index([active])
  @@map("surveys")
}

model SurveyResponse {
  id          String                @id @default(uuid()) @db.Uuid
  surveyId    String                @map("survey_id") @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  answers     Json
  coinReward  Int                   @default(0) @map("coin_reward")
  status      OfferCompletionStatus @default(valid)
  ipAddress   String?               @map("ip_address")
  completedAt DateTime              @default(now()) @map("completed_at")

  survey Survey @relation(fields: [surveyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([surveyId, userId])
  @@index([userId, completedAt])
  @@map("survey_responses")
}

model AppInstallOffer {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  appName     String   @map("app_name")
  packageName String?  @map("package_name")
  storeUrl    String   @map("store_url")
  iconUrl     String?  @map("icon_url")
  /// { description, instructions }
  details     Json
  rewardEtb   Decimal  @map("reward_etb") @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  campaign    Campaign               @relation(fields: [campaignId], references: [id])
  completions AppInstallCompletion[]

  @@index([campaignId])
  @@index([active])
  @@map("app_install_offers")
}

model AppInstallCompletion {
  id                String                @id @default(uuid()) @db.Uuid
  offerId           String                @map("offer_id") @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  deviceFingerprint String                @map("device_fingerprint")
  proof             String?
  status            OfferCompletionStatus @default(pending_verification)
