/**
 * Withdrawals
 */
/**
 * ------------------------------------------------------------------
 */

model Withdrawal {
  id                     String           @id @default(uuid()) @db.Uuid
  userId                 String           @map("user_id") @db.Uuid
  amountEtb              Decimal          @map("amount_etb") @db.Decimal(12, 2)
  coinAmount             Int              @map("coin_amount")
  payoutMethod           PayoutMethod     @map("payout_method")
  payoutDestination      String           @map("payout_destination")
  destinationName        String?          @map("destination_name")
  bankCode               String?          @map("bank_code")
  /// Account holder name returned by the partner's account lookup (PayoutProvider.resolveAccount).
  destinationAccountName String?          @map("destination_account_name")
  destinationVerifiedAt  DateTime?        @map("destination_verified_at")
  payoutDestinationId    String?          @map("payout_destination_id") @db.Uuid
  status                 WithdrawalStatus @default(pending)
  /// e.g. ["first_withdrawal", "large_amount"]
  reviewReasons          Json             @default("[]") @map("review_reasons")
  isFirstWithdrawal      Boolean          @default(false) @map("is_first_withdrawal")
  requiresDualApproval   Boolean          @default(false) @map("requires_dual_approval")
  reviewNote             String?          @map("review_note")
  failureReason          String?          @map("failure_reason")
  providerName           String?          @map("provider_name")
  providerPayoutId       String?          @map("provider_payout_id")
  providerStatusRaw      Json?            @map("provider_status_raw")
  attempts               Int              @default(0)
  ledgerHoldEntryId      String?          @unique @map("ledger_hold_entry_id") @db.Uuid
  ledgerReversalEntryId  String?          @unique @map("ledger_reversal_entry_id") @db.Uuid
  requestedAt            DateTime         @default(now()) @map("requested_at")
  processedAt            DateTime?        @map("processed_at")
  processedBy            String?          @map("processed_by") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id])
  approvals   WithdrawalApproval[]
  destination PayoutDestination?   @relation(fields: [payoutDestinationId], references: [id])

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([providerPayoutId])
  @@map("withdrawals")
}

/// A payout destination the user has verified (partner name lookup + OTP re-check) and may reuse.
model PayoutDestination {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  payoutMethod  PayoutMethod @map("payout_method")
  /// Normalised destination (E.164 phone or bank account number).
  destination   String
  bankCode      String?      @map("bank_code")
  /// Account holder name returned by the partner lookup (MOCK: deterministic fake name).
  accountName   String?      @map("account_name")
  providerName  String?      @map("provider_name")
  providerMock  Boolean      @default(true) @map("provider_mock")
  /// Last successful resolveAccount(); a NEW destination needs one within DESTINATION_RESOLVE_TTL_MINUTES.
  verifiedAt    DateTime?    @map("verified_at")
  /// Last OTP re-check for this destination (purpose destination_change).
  otpVerifiedAt DateTime?    @map("otp_verified_at")
  /// Set when a withdrawal to this destination was successfully requested (=> "known" destination).
  lastUsedAt    DateTime?    @map("last_used_at")
  useCount      Int          @default(0) @map("use_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id])
  withdrawals Withdrawal[]

  @@unique([userId, payoutMethod, destination])
  @@index([userId, lastUsedAt])
  @@map("payout_destinations")
}

/// One row per admin decision; the unique constraint enforces two DISTINCT admins for dual approval.
model WithdrawalApproval {
  id           String           @id @default(uuid()) @db.Uuid
  withdrawalId String           @map("withdrawal_id") @db.Uuid
  adminId      String           @map("admin_id") @db.Uuid
  decision     ApprovalDecision
  note         String?
  createdAt    DateTime         @default(now()) @map("created_at")

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id])
  admin      AdminUser  @relation(fields: [adminId], references: [id])

  @@unique([withdrawalId, adminId])
  @@map("withdrawal_approvals")
}

