// Rewarded Advertising Platform (Ethiopia) - PostgreSQL schema.
// Naming: camelCase in the client, snake_case tables/columns in Postgres.
// Money: ETB amounts are Decimal(12,2); coins are integers (1 ETB = COINS_PER_ETB coins).
// Append-only tables (coin_ledger, advertiser_wallet_ledger, audit_log) are additionally protected
// by Postgres triggers created in prisma/migrations (see ARCHITECTURE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Enums
 */
/**
 * ------------------------------------------------------------------
 */

enum AgeVerificationStatus {
  pending
  verified_adult
  rejected
}

enum UserStatus {
  active
  suspended
  banned
  /// Account deletion executed: PII anonymised, ledger/audit retained (see ARCHITECTURE.md §15).
  deleted
}

/// KYC tier. `phone_only` (OTP-verified number) is the default; `id_verified` after an approved KYC submission.
enum KycTier {
  phone_only
  id_verified
}

enum KycIdType {
  fayda
  national_id
  passport
}

enum KycStatus {
  pending
  approved
  rejected
}

enum LegalDocumentKind {
  terms
  privacy
}

enum AlertSeverity {
  info
  warning
  critical
}

enum ReferralStatus {
  /// Referee signed up with the code; waiting for their first valid ad completion.
  pending
  /// Referee qualified but the bonus was withheld (referrer daily cap / referrer inactive) - not fraud.
  qualified
  /// Both bonuses credited through the ledger (same transaction as the qualifying completion).
  paid
  /// Fraud guard fired (shared device / IP with the referrer).
  rejected
}

/// Creative processing state (media.process job): probe -> transcode -> ready.
enum MediaStatus {
  processing
  ready
  /// Probed duration differed from the declared one by more than 1 s; duration_seconds was corrected.
  duration_corrected
  failed
}

enum DataExportStatus {
  pending
  processing
  ready
  failed
}

enum DeletionRequestStatus {
  pending
  executed
  cancelled
}

enum OtpPurpose {
  login
  destination_change
}

enum Language {
  am
  en
  om
  ti
}

enum AdvertiserVerificationStatus {
  pending
  verified
  rejected
}

enum CampaignStatus {
  draft
  pending_review
  active
  paused
  completed
  rejected
}

enum TargetActionType {
  video_view
  survey
  app_install
}

enum MediaType {
  video
  image
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum WatchSessionStatus {
  active
  completed
  rejected
  abandoned
  expired
}

enum CompletionStatus {
  valid
  flagged
  rejected
}

enum LedgerSourceType {
  ad_view
  survey
  app_install
  withdrawal
  withdrawal_reversal
  admin_adjustment
  reconciliation
  /// Referral bonus (referrer or referee), credited with the referee's first valid completion.
  referral
}

enum PayoutMethod {
  telebirr
  bank
  cbe_birr
}

enum WithdrawalStatus {
  pending
  processing
  completed
  failed
  flagged_for_review
  rejected
  /// Provider outcome unknown after a timeout / 5xx / exhausted polling: money may be in flight, so coins stay
  /// held until finance confirms the partner result (admin marks completed or failed with a reason).
  needs_manual_review
}

enum ApprovalDecision {
  approved
  rejected
}

enum FraudSeverity {
  low
  medium
  high
  critical
}

enum FraudResolution {
  dismissed
  escalated
  confirmed
}

enum AdminRole {
  super_admin
  ad_reviewer
  support
  finance
}

enum ActorType {
  admin
  system
  user
  advertiser
}

enum AuthSubjectType {
  user
  advertiser
  admin
}

enum CoinAdjustmentStatus {
  pending_approval
  executed
  rejected
  cancelled
}

enum AdvertiserLedgerEntryType {
  topup
  campaign_budget_reservation
  campaign_budget_refund
  adjustment
}

enum PaymentStatus {
  pending
  completed
  failed
  cancelled
}

enum InvoiceStatus {
  issued
  paid
  void
}

enum NotificationType {
  reward_confirmed
  reward_flagged
  withdrawal_status
  new_offer
  account_status
  system
  kyc_status
  referral
  data_export
  account_deletion
}

enum PushStatus {
  pending
  sent
  failed
  skipped
}

enum DevicePlatform {
  android
  ios
  web
}

enum AdReportReason {
  inappropriate
  misleading
  broken_media
  offensive
  banned_topic
  other
}

enum AdReportStatus {
  open
  reviewed
  dismissed
}

enum OfferCompletionStatus {
  pending_verification
  valid
  flagged
  rejected
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Identity
 */
/**
 * ------------------------------------------------------------------
 */

model User {
  id                      String                @id @default(uuid()) @db.Uuid
  phoneNumber             String                @unique @map("phone_number")
  phoneVerifiedAt         DateTime?             @map("phone_verified_at")
  fullName                String?               @map("full_name")
  dateOfBirth             DateTime?             @map("date_of_birth") @db.Date
  ageVerificationStatus   AgeVerificationStatus @default(pending) @map("age_verification_status")
  deviceId                String?               @map("device_id")
  /// Reserved for optional password auth; users authenticate with OTP only today.
  passwordHash            String?               @map("password_hash")
  languagePreference      Language              @default(am) @map("language_preference")
  /// CACHED value. Written ONLY by LedgerService.applyEntry inside the ledger transaction.
  coinBalance             Int                   @default(0) @map("coin_balance")
  trustScore              Int                   @default(50) @map("trust_score")
  status                  UserStatus            @default(active)
  statusReason            String?               @map("status_reason")
  notificationPrefs       Json                  @default("{\"rewards\":true,\"withdrawals\":true,\"offers\":true}") @map("notification_prefs")
  lastLoginAt             DateTime?             @map("last_login_at")
  lastIp                  String?               @map("last_ip")
  /// KYC tier; `id_verified` once a KYC submission is approved. Gates payouts at or above KYC_REQUIRED_ABOVE_MONTHLY_ETB (inclusive).
  kycTier                 KycTier               @default(phone_only) @map("kyc_tier")
  /// 6-char shareable referral code (unique; generated on first login / on demand).
  referralCode            String?               @unique @map("referral_code")
  /// Device fingerprint / IP recorded at account creation (referral fraud guards, account-minting alerts).
  signupDeviceFingerprint String?               @map("signup_device_fingerprint")
  signupIp                String?               @map("signup_ip")
  /// Set when an account deletion request was executed (PII anonymised).
  anonymizedAt            DateTime?             @map("anonymized_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  watchSessions         AdWatchSession[]
  completions           AdCompletion[]
  ledgerEntries         CoinLedger[]
  withdrawals           Withdrawal[]
  fraudFlags            FraudFlag[]
  surveyResponses       SurveyResponse[]
  appInstallCompletions AppInstallCompletion[]
  notifications         Notification[]
  pushTokens            DevicePushToken[]
  adReports             AdReport[]
  coinAdjustments       CoinAdjustmentRequest[]
  payoutDestinations    PayoutDestination[]
  kycSubmissions        KycSubmission[]
  consents              UserConsent[]
  referralsMade         Referral[]               @relation("Referrer")
  referralReceived      Referral?                @relation("Referee")
  dataExports           DataExportRequest[]
  deletionRequests      AccountDeletionRequest[]

  @@index([status])
  @@index([deviceId])
  @@index([trustScore])
  @@index([createdAt])
  @@index([signupDeviceFingerprint, createdAt])
  @@map("users")
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  phoneNumber String     @map("phone_number")
  codeHash    String     @map("code_hash")
  /// login (default) or destination_change (re-check before paying out to a new destination).
  purpose     OtpPurpose @default(login)
  expiresAt   DateTime   @map("expires_at")
  attempts    Int        @default(0)
  consumedAt  DateTime?  @map("consumed_at")
  ipAddress   String?    @map("ip_address")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([phoneNumber, createdAt])
  @@index([ipAddress, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id           String          @id @default(uuid()) @db.Uuid
  tokenHash    String          @unique @map("token_hash")
  subjectType  AuthSubjectType @map("subject_type")
  subjectId    String          @map("subject_id") @db.Uuid
  /// All tokens descending from one login share a family; reuse of a rotated token revokes the family.
  familyId     String          @map("family_id") @db.Uuid
  expiresAt    DateTime        @map("expires_at")
  revokedAt    DateTime?       @map("revoked_at")
  replacedById String?         @map("replaced_by_id") @db.Uuid
  userAgent    String?         @map("user_agent")
  ipAddress    String?         @map("ip_address")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([subjectType, subjectId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AdminUser {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  role               AdminRole
  active             Boolean   @default(true)
  lastLoginAt        DateTime? @map("last_login_at")
  /// TOTP secret (AES-256-GCM encrypted at rest with MFA_ENCRYPTION_KEY / derived from JWT_ACCESS_SECRET).
  mfaSecret          String?   @map("mfa_secret")
  /// Set once the admin confirmed a valid code; null = MFA not enabled.
  mfaEnabledAt       DateTime? @map("mfa_enabled_at")
  /// Accounts created / reset by a super_admin start with a temporary password that must be changed first.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  reviewedAds          Ad[]                    @relation("AdReviewer")
  withdrawalApprovals  WithdrawalApproval[]
  requestedAdjustments CoinAdjustmentRequest[] @relation("AdjustmentRequester")
  approvedAdjustments  CoinAdjustmentRequest[] @relation("AdjustmentApprover")

  @@map("admin_users")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Advertisers, wallet, billing
 */
/**
 * ------------------------------------------------------------------
 */

model Advertiser {
  id                         String                       @id @default(uuid()) @db.Uuid
  businessName               String                       @map("business_name")
  businessRegistrationNumber String                       @unique @map("business_registration_number")
  contactEmail               String                       @unique @map("contact_email")
  contactPhone               String                       @map("contact_phone")
  passwordHash               String                       @map("password_hash")
  verificationStatus         AdvertiserVerificationStatus @default(pending) @map("verification_status")
  verificationNote           String?                      @map("verification_note")
  verifiedBy                 String?                      @map("verified_by") @db.Uuid
  verifiedAt                 DateTime?                    @map("verified_at")
  /// CACHED value. Written ONLY by AdvertiserWalletService.applyEntry inside the wallet ledger transaction.
  walletBalanceEtb           Decimal                      @default(0) @map("wallet_balance_etb") @db.Decimal(12, 2)
  notificationPrefs          Json                         @default("{\"campaignReviews\":true,\"billing\":true,\"weeklyReport\":true}") @map("notification_prefs")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")

  campaigns     Campaign[]
  walletEntries AdvertiserWalletLedger[]
  payments      AdvertiserPayment[]
  invoices      Invoice[]
  consents      AdvertiserConsent[]

  @@index([verificationStatus])
  @@map("advertisers")
}

/// Append-only ETB ledger of advertiser prepaid funds (B2B receivable; never user funds).
model AdvertiserWalletLedger {
  id              String                    @id @default(uuid()) @db.Uuid
  advertiserId    String                    @map("advertiser_id") @db.Uuid
  amountEtb       Decimal                   @map("amount_etb") @db.Decimal(12, 2)
  balanceAfterEtb Decimal                   @map("balance_after_etb") @db.Decimal(12, 2)
  entryType       AdvertiserLedgerEntryType @map("entry_type")
  referenceType   String?                   @map("reference_type")
  referenceId     String?                   @map("reference_id") @db.Uuid
  idempotencyKey  String?                   @unique @map("idempotency_key")
  description     String?
  createdAt       DateTime                  @default(now()) @map("created_at")

  advertiser Advertiser @relation(fields: [advertiserId], references: [id])

  @@index([advertiserId, createdAt])
  @@map("advertiser_wallet_ledger")
}

model AdvertiserPayment {
  id               String        @id @default(uuid()) @db.Uuid
  advertiserId     String        @map("advertiser_id") @db.Uuid
  amountEtb        Decimal       @map("amount_etb") @db.Decimal(12, 2)
  currency         String        @default("ETB")
  gateway          String        @default("chapa")
  /// Our transaction reference sent to the gateway (unique, used for webhook idempotency).
  txRef            String        @unique @map("tx_ref")
  gatewayReference String?       @map("gateway_reference")
  checkoutUrl      String?       @map("checkout_url")
  /**
   * Where the browser is sent after checkout (caller-supplied; mock checkout honours it).
   */
  returnUrl        String?       @map("return_url")
  status           PaymentStatus @default(pending)
  mock             Boolean       @default(false)
  rawWebhook       Json?         @map("raw_webhook")
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  advertiser Advertiser @relation(fields: [advertiserId], references: [id])
  invoice    Invoice?

  @@index([advertiserId, createdAt])
  @@index([status])
  @@map("advertiser_payments")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  advertiserId  String        @map("advertiser_id") @db.Uuid
  invoiceNumber String        @unique @map("invoice_number")
  status        InvoiceStatus @default(issued)
  subtotalEtb   Decimal       @map("subtotal_etb") @db.Decimal(12, 2)
  vatEtb        Decimal       @default(0) @map("vat_etb") @db.Decimal(12, 2)
  totalEtb      Decimal       @map("total_etb") @db.Decimal(12, 2)
  currency      String        @default("ETB")
  lineItems     Json          @map("line_items")
  paymentId     String?       @unique @map("payment_id") @db.Uuid
  issuedAt      DateTime      @default(now()) @map("issued_at")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  advertiser Advertiser         @relation(fields: [advertiserId], references: [id])
  payment    AdvertiserPayment? @relation(fields: [paymentId], references: [id])

  @@index([advertiserId, issuedAt])
  @@map("invoices")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Campaigns & ads
 */
/**
 * ------------------------------------------------------------------
 */

model Campaign {
  id                        String           @id @default(uuid()) @db.Uuid
  advertiserId              String           @map("advertiser_id") @db.Uuid
  title                     String
  description               String?
  budgetEtb                 Decimal          @map("budget_etb") @db.Decimal(12, 2)
  /// CACHED sum of cost_etb over valid completions; updated atomically in the completion transaction.
  spentEtb                  Decimal          @default(0) @map("spent_etb") @db.Decimal(12, 2)
  status                    CampaignStatus   @default(draft)
  startDate                 DateTime?        @map("start_date") @db.Date
  endDate                   DateTime?        @map("end_date") @db.Date
  targetActionType          TargetActionType @map("target_action_type")
  /// What the advertiser pays per valid action.
  costPerActionEtb          Decimal          @map("cost_per_action_etb") @db.Decimal(12, 2)
  /// What the user earns per valid action = cost * (1 - PLATFORM_TAKE_RATE), snapshotted at creation.
  rewardPerActionEtb        Decimal          @map("reward_per_action_etb") @db.Decimal(12, 2)
  takeRateSnapshot          Decimal          @map("take_rate_snapshot") @db.Decimal(5, 4)
  attentionCheckEnabled     Boolean          @default(true) @map("attention_check_enabled")
  /// Max rewarded completions of this campaign's ads per user per UTC day (advertiser-editable 1-5).
  frequencyCapPerUserPerDay Int              @default(1) @map("frequency_cap_per_user_per_day")
  submittedAt               DateTime?        @map("submitted_at")
  reviewedAt                DateTime?        @map("reviewed_at")
  reviewedBy                String?          @map("reviewed_by") @db.Uuid
  rejectionReason           String?          @map("rejection_reason")
  pausedReason              String?          @map("paused_reason")
  completedAt               DateTime?        @map("completed_at")
  budgetReservedEtb         Decimal          @default(0) @map("budget_reserved_etb") @db.Decimal(12, 2)
  /// Incremented in the same transaction as every submit; keys the wallet reservation/refund entries so a
  /// rejected -> edited -> resubmitted campaign can never replay an earlier (already refunded) reservation.
  submissionSeq             Int              @default(0) @map("submission_seq")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  advertiser       Advertiser        @relation(fields: [advertiserId], references: [id])
  ads              Ad[]
  completions      AdCompletion[]
  surveys          Survey[]
  appInstallOffers AppInstallOffer[]

  @@index([advertiserId])
  @@index([status])
  @@index([targetActionType, status])
  @@map("campaigns")
}

model Ad {
  id                      String       @id @default(uuid()) @db.Uuid
  campaignId              String       @map("campaign_id") @db.Uuid
  title                   String
  description             String?
  mediaUrl                String       @map("media_url")
  thumbnailUrl            String?      @map("thumbnail_url")
  storageKey              String?      @map("storage_key")
  mediaType               MediaType    @map("media_type")
  durationSeconds         Int          @map("duration_seconds")
  reviewStatus            ReviewStatus @default(pending) @map("review_status")
  reviewedBy              String?      @map("reviewed_by") @db.Uuid
  reviewedAt              DateTime?    @map("reviewed_at")
  rejectionReason         String?      @map("rejection_reason")
  reviewNote              String?      @map("review_note")
  /// Structured banned-topics checklist filled by the reviewer: { checks: {alcohol: true, ...}, notes }.
  bannedTopicsChecklist   Json?        @map("banned_topics_checklist")
  /// media.process pipeline state. Review cannot approve while processing/failed.
  mediaStatus             MediaStatus  @default(ready) @map("media_status")
  /// ffprobe result: { durationSeconds, codec, width, height, bitrate, container }.
  mediaProbe              Json?        @map("media_probe")
  durationDeclaredSeconds Int?         @map("duration_declared_seconds")
  durationProbedSeconds   Int?         @map("duration_probed_seconds")
  /// Original (advertiser-uploaded) URL kept when media_url is switched to the transcoded rendition.
  originalMediaUrl        String?      @map("original_media_url")
  transcodedStorageKey    String?      @map("transcoded_storage_key")
  mediaError              String?      @map("media_error")
  mediaProcessedAt        DateTime?    @map("media_processed_at")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  campaign           Campaign            @relation(fields: [campaignId], references: [id])
  reviewer           AdminUser?          @relation("AdReviewer", fields: [reviewedBy], references: [id])
  attentionQuestions AttentionQuestion[]
  watchSessions      AdWatchSession[]
  completions        AdCompletion[]
  reports            AdReport[]

  @@index([campaignId])
  @@index([reviewStatus])
  @@index([mediaStatus])
  @@map("ads")
}

model AttentionQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  adId         String   @map("ad_id") @db.Uuid
  prompt       String
  promptAm     String?  @map("prompt_am")
  /// JSON array of option strings.
  options      Json
  correctIndex Int      @map("correct_index")
  createdAt    DateTime @default(now()) @map("created_at")

  ad            Ad               @relation(fields: [adId], references: [id], onDelete: Cascade)
  watchSessions AdWatchSession[]

  @@index([adId])
  @@map("attention_questions")
}

/// Server-recorded watch session. All timing decisions use these server timestamps.
model AdWatchSession {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @map("user_id") @db.Uuid
  adId                    String             @map("ad_id") @db.Uuid
  startedAt               DateTime           @default(now()) @map("started_at")
  lastHeartbeatAt         DateTime?          @map("last_heartbeat_at")
  heartbeatCount          Int                @default(0) @map("heartbeat_count")
  expectedDurationSeconds Int                @map("expected_duration_seconds")
  expiresAt               DateTime           @map("expires_at")
  deviceFingerprint       String             @map("device_fingerprint")
  deviceId                String?            @map("device_id")
  ipAddress               String             @map("ip_address")
  userAgent               String?            @map("user_agent")
  status                  WatchSessionStatus @default(active)
  attentionQuestionId     String?            @map("attention_question_id") @db.Uuid
  /// Per-session shuffle of the attention options: optionOrder[i] = original index shown at position i. The
  /// client answers with a POSITION; the server maps it back (A3a: no fixed answer position to brute-force).
  attentionOptionOrder    Json?              @map("attention_option_order")
  completedAt             DateTime?          @map("completed_at")
  rejectionCode           String?            @map("rejection_code")
  createdAt               DateTime           @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id])
  ad                Ad                 @relation(fields: [adId], references: [id])
  attentionQuestion AttentionQuestion? @relation(fields: [attentionQuestionId], references: [id])
  completion        AdCompletion?

  @@index([userId, adId, startedAt])
  @@index([deviceFingerprint])
  @@index([ipAddress, startedAt])
  @@index([status, expiresAt])
  @@map("ad_watch_sessions")
}

model AdCompletion {
  id                     String           @id @default(uuid()) @db.Uuid
  userId                 String           @map("user_id") @db.Uuid
  adId                   String           @map("ad_id") @db.Uuid
  campaignId             String           @map("campaign_id") @db.Uuid
  watchSessionId         String           @unique @map("watch_session_id") @db.Uuid
  startedAt              DateTime         @map("started_at")
  completedAt            DateTime         @map("completed_at")
  watchDurationSeconds   Int              @map("watch_duration_seconds")
  serverVerified         Boolean          @default(true) @map("server_verified")
  deviceFingerprint      String           @map("device_fingerprint")
  ipAddress              String           @map("ip_address")
  /// JSON array of fraud rule ids that fired.
  fraudFlags             Json             @default("[]") @map("fraud_flags")
  fraudScore             Int              @default(0) @map("fraud_score")
  attentionAnswerCorrect Boolean?         @map("attention_answer_correct")
  coinRewardAmount       Int              @default(0) @map("coin_reward_amount")
  rewardEtb              Decimal          @default(0) @map("reward_etb") @db.Decimal(12, 2)
  costEtb                Decimal          @default(0) @map("cost_etb") @db.Decimal(12, 2)
  status                 CompletionStatus
  rejectionCode          String?          @map("rejection_code")
  createdAt              DateTime         @default(now()) @map("created_at")

  user         User           @relation(fields: [userId], references: [id])
  ad           Ad             @relation(fields: [adId], references: [id])
  campaign     Campaign       @relation(fields: [campaignId], references: [id])
  watchSession AdWatchSession @relation(fields: [watchSessionId], references: [id])

  @@index([userId, adId])
  @@index([userId, completedAt])
  @@index([campaignId, completedAt])
  @@index([campaignId, status])
  @@index([deviceFingerprint])
  @@index([ipAddress, completedAt])
  @@map("ad_completions")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Coins
 */
/**
 * ------------------------------------------------------------------
 */

/// APPEND-ONLY. UPDATE/DELETE are blocked by a Postgres trigger (migration 0001).
model CoinLedger {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  /// Signed coins. Negative for withdrawals / negative adjustments.
  amount         Int
  balanceAfter   Int              @map("balance_after")
  sourceType     LedgerSourceType @map("source_type")
  sourceId       String?          @map("source_id") @db.Uuid
  /// Guarantees each business event credits at most once (e.g. "ad_completion:<sessionId>").
  idempotencyKey String           @unique @map("idempotency_key")
  description    String?
  /// Admin who requested the manual adjustment (nullable; system entries have none).
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@map("coin_ledger")
}

model CoinAdjustmentRequest {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  amount        Int
  reason        String
  reference     String?
  status        CoinAdjustmentStatus @default(pending_approval)
  requestedBy   String               @map("requested_by") @db.Uuid
  approvedBy    String?              @map("approved_by") @db.Uuid
  rejectedBy    String?              @map("rejected_by") @db.Uuid
  decisionNote  String?              @map("decision_note")
  ledgerEntryId String?              @unique @map("ledger_entry_id") @db.Uuid
  executedAt    DateTime?            @map("executed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id])
  requester AdminUser  @relation("AdjustmentRequester", fields: [requestedBy], references: [id])
  approver  AdminUser? @relation("AdjustmentApprover", fields: [approvedBy], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("coin_adjustment_requests")
}

model LedgerReconciliationRun {
  id           String    @id @default(uuid()) @db.Uuid
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  usersChecked Int       @default(0) @map("users_checked")
  driftCount   Int       @default(0) @map("drift_count")
  /// [{ userId, cachedBalance, ledgerSum, lastBalanceAfter }]
  drifts       Json      @default("[]")
  status       String    @default("running")
  error        String?

  @@index([startedAt])
  @@map("ledger_reconciliation_runs")
}

/**
