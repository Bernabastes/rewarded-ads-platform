/**
 * Phase 4A: idempotency, KYC, consent, alerts, referrals, data rights
 */
/**
 * ------------------------------------------------------------------
 */

/// Stored responses for `Idempotency-Key` requests on money POSTs (24 h TTL). A row is inserted BEFORE the
/// handler runs (status_code 0 = in progress) so concurrent duplicates are rejected, then completed.
model IdempotencyKey {
  id           String          @id @default(uuid()) @db.Uuid
  key          String
  actorType    AuthSubjectType @map("actor_type")
  actorId      String          @map("actor_id") @db.Uuid
  method       String
  path         String
  /// sha256 of the canonical JSON body: same key + different hash => 409 IDEMPOTENCY_KEY_REUSED.
  requestHash  String          @map("request_hash")
  statusCode   Int             @default(0) @map("status_code")
  responseBody Json?           @map("response_body")
  createdAt    DateTime        @default(now()) @map("created_at")
  expiresAt    DateTime        @map("expires_at")

  @@unique([actorType, actorId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model KycSubmission {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  idType           KycIdType @map("id_type")
  /// sha256(idType:idNumber) - the raw number is never stored.
  idNumberHash     String    @map("id_number_hash")
  idNumberLast4    String    @map("id_number_last4")
  fullName         String    @map("full_name")
  dateOfBirth      DateTime  @map("date_of_birth") @db.Date
  /// Private S3 keys (never public URLs); admins get 5-minute presigned GET links.
  documentFrontKey String    @map("document_front_key")
  documentBackKey  String?   @map("document_back_key")
  selfieKey        String    @map("selfie_key")
  status           KycStatus @default(pending)
  /// IdVerificationProvider result (MockFaydaProvider today): { provider, mock, match, score, ... }.
  providerName     String?   @map("provider_name")
  providerResult   Json?     @map("provider_result")
  reviewedBy       String?   @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at")
  reason           String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([idNumberHash])
  @@map("kyc_submissions")
}

/// Published legal documents. "Current" = latest published_at per kind; a version exists in every locale.
model LegalDocument {
  id              String            @id @default(uuid()) @db.Uuid
  kind            LegalDocumentKind
  version         String
  locale          Language
  title           String
  url             String?
  contentMarkdown String?           @map("content_markdown")
  publishedAt     DateTime          @default(now()) @map("published_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@unique([kind, version, locale])
  @@index([kind, publishedAt])
  @@map("legal_documents")
}

model UserConsent {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  kind       LegalDocumentKind
  version    String
  acceptedAt DateTime          @default(now()) @map("accepted_at")
  ipAddress  String?           @map("ip_address")
  deviceId   String?           @map("device_id")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, kind, version])
  @@map("user_consents")
}

model AdvertiserConsent {
  id           String            @id @default(uuid()) @db.Uuid
  advertiserId String            @map("advertiser_id") @db.Uuid
  kind         LegalDocumentKind
  version      String
  acceptedAt   DateTime          @default(now()) @map("accepted_at")
  ipAddress    String?           @map("ip_address")

  advertiser Advertiser @relation(fields: [advertiserId], references: [id])

  @@unique([advertiserId, kind, version])
  @@map("advertiser_consents")
}

/// Money-day alerts raised by AlertService (ledger drift, payout failure rate, account minting, spend velocity,
/// OTP spikes). Delivered to Telegram / webhook / log; acknowledged by an admin.
model PlatformAlert {
  id             String        @id @default(uuid()) @db.Uuid
  type           String
  severity       AlertSeverity
  title          String
  payload        Json
  /// Same dedupe key within ALERT_DEDUPE_MINUTES is not re-raised.
  dedupeKey      String?       @map("dedupe_key")
  /// Per-notifier delivery outcome: [{ notifier, ok, error? }].
  deliveries     Json?
  acknowledgedBy String?       @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime?     @map("acknowledged_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([acknowledgedAt])
  @@index([dedupeKey, createdAt])
  @@map("platform_alerts")
}

model Referral {
  id                      String         @id @default(uuid()) @db.Uuid
  referrerId              String         @map("referrer_id") @db.Uuid
  refereeId               String         @unique @map("referee_id") @db.Uuid
  code                    String
  status                  ReferralStatus @default(pending)
  referrerBonusCoins      Int            @default(0) @map("referrer_bonus_coins")
  refereeBonusCoins       Int            @default(0) @map("referee_bonus_coins")
  /// The referee's first valid completion that qualified the referral.
  qualifyingCompletionId  String?        @map("qualifying_completion_id") @db.Uuid
  qualifiedAt             DateTime?      @map("qualified_at")
  paidAt                  DateTime?      @map("paid_at")
  /// self_referral_device | self_referral_ip | referrer_daily_cap | referrer_inactive
  rejectionReason         String?        @map("rejection_reason")
  signupIp                String?        @map("signup_ip")
  signupDeviceFingerprint String?        @map("signup_device_fingerprint")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  referee  User @relation("Referee", fields: [refereeId], references: [id])

  @@index([referrerId, createdAt])
  @@index([status, createdAt])
  @@map("referrals")
}

model DataExportRequest {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      DataExportStatus @default(pending)
  /// Private S3 key of the JSON archive; download links are presigned on read.
  storageKey  String?          @map("storage_key")
  sizeBytes   Int?             @map("size_bytes")
  error       String?
  requestedAt DateTime         @default(now()) @map("requested_at")
  completedAt DateTime?        @map("completed_at")
  expiresAt   DateTime?        @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, requestedAt])
  @@index([status])
  @@map("data_export_requests")
}

/// Right-to-erasure requests: executed after ACCOUNT_DELETION_GRACE_DAYS unless cancelled; PII is anonymised
/// while ledger, completions and audit rows are retained (financial-record obligations).
model AccountDeletionRequest {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  status       DeletionRequestStatus @default(pending)
  reason       String?
  requestedAt  DateTime              @default(now()) @map("requested_at")
  scheduledFor DateTime              @map("scheduled_for")
  executedAt   DateTime?             @map("executed_at")
  executedBy   String?               @map("executed_by") @db.Uuid
  cancelledAt  DateTime?             @map("cancelled_at")
  cancelledBy  String?               @map("cancelled_by") @db.Uuid
  note         String?
  ipAddress    String?               @map("ip_address")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([status, scheduledFor])
  @@index([userId, requestedAt])
  @@map("account_deletion_requests")
}
