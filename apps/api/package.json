{
  "name": "@rap/api",
  "version": "0.1.0",
  "private": true,
  "description": "Rewarded Ads Platform backend API (NestJS + Prisma + PostgreSQL + Redis + BullMQ)",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test prisma --max-warnings 0",
    "test": "node scripts/run-jest.cjs --config jest.config.cjs",
    "test:watch": "node scripts/run-jest.cjs --config jest.config.cjs --watch",
    "test:cov": "node scripts/run-jest.cjs --config jest.config.cjs --coverage",
    "test:e2e": "node scripts/run-jest.cjs --config test/jest-e2e.config.cjs --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register prisma/seed.ts",
    "openapi:export": "nest build && node dist/openapi-export.js",
    "worker": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "~6.19.3",
    "@rap/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.5",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prisma": "~6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  }
}
