# Advertiser web portal — environment variables (copy to .env.local)

# Base URL of the API (without /api/v1; API_BASE_PATH from @rap/shared is appended).
VITE_API_URL=http://localhost:3000

# Public URL of this portal; used to build the top-up returnUrl passed to the payment gateway.
# Defaults to window.location.origin when unset.
# VITE_PUBLIC_URL=http://localhost:5173

# Creative uploads. Presigned MinIO URLs returned by the API are signed for the Docker-internal host
# (http://minio:9000) which the browser cannot reach. In development the Vite dev server proxies uploads
# through VITE_UPLOAD_PROXY_PATH to VITE_UPLOAD_PROXY_TARGET while preserving the signed Host header.
# Set VITE_UPLOAD_INTERNAL_ORIGIN to an empty value to disable the rewrite (e.g. when the API presigns
# with a publicly reachable endpoint).
VITE_UPLOAD_INTERNAL_ORIGIN=http://minio:9000
VITE_UPLOAD_PROXY_PATH=/__media-upload
VITE_UPLOAD_PROXY_TARGET=http://localhost:9000
