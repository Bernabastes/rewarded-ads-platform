# Advertiser web portal — environment variables (copy to .env.local)

# Base URL of the API (without /api/v1; API_BASE_PATH from @rap/shared is appended).
VITE_API_URL=http://localhost:3000

# Public URL of this portal; used to build the top-up returnUrl passed to the payment gateway.
# Defaults to window.location.origin when unset.
# VITE_PUBLIC_URL=http://localhost:5173

# Creative uploads go straight from the browser to object storage using the presigned URL returned by the API.
# The API signs those URLs for its S3_PUBLIC_ENDPOINT (http://localhost:9000 in the default stack), so no proxy
# is needed. LEGACY / OPT-IN ONLY: if an API signs URLs for a host the browser cannot reach (e.g. Docker-internal
# http://minio:9000), set VITE_UPLOAD_INTERNAL_ORIGIN and the Vite dev server proxies PUTs through
# VITE_UPLOAD_PROXY_PATH to VITE_UPLOAD_PROXY_TARGET while preserving the signed Host header.
# VITE_UPLOAD_INTERNAL_ORIGIN=http://minio:9000
# VITE_UPLOAD_PROXY_PATH=/__media-upload
# VITE_UPLOAD_PROXY_TARGET=http://localhost:9000
