{
  "name": "rewarded-ads-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Rewarded Advertising Platform (Ethiopia) - pnpm monorepo: NestJS API, shared types, mobile app, advertiser portal, admin dashboard",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "postinstall": "node scripts/build-shared.mjs",
    "build": "node scripts/run-workspace.mjs build",
    "typecheck": "node scripts/run-workspace.mjs typecheck",
    "lint": "node scripts/run-workspace.mjs lint",
    "test": "node scripts/run-workspace.mjs test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "node scripts/run-workspace.mjs dev --filter @rap/api",
    "dev:advertiser": "node scripts/run-workspace.mjs dev --filter @rap/advertiser-web",
    "dev:admin": "node scripts/run-workspace.mjs dev --filter @rap/admin-web",
    "dev:mobile": "node scripts/run-workspace.mjs web --filter @rap/mobile",
    "dev": "concurrently -k -n api,advertiser,admin -c blue,green,magenta \"node scripts/run-workspace.mjs dev --filter @rap/api\" \"node scripts/run-workspace.mjs dev --filter @rap/advertiser-web\" \"node scripts/run-workspace.mjs dev --filter @rap/admin-web\"",
    "media:tools": "node scripts/install-media-tools.mjs",
    "demo": "powershell -ExecutionPolicy Bypass -File scripts/demo.ps1",
    "infra:up": "docker compose up -d postgres redis minio minio-init",
    "infra:down": "docker compose down",
    "smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
